# Trading Assistant Frontend — Environment Variables (Phase 1)
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# ------------------------------------------
# Backend Connection
# ------------------------------------------
# URL of the trading-assistant Spring Boot backend
# Leave empty to use in-memory mock data (demo mode)
VITE_API_URL=https://trading-assistance-production-8d09.up.railway.app

# WebSocket URL (Phase 2 — not used in Phase 1)
# VITE_WS_URL=wss://localhost:8080

# ------------------------------------------
# Local Auth (Phase 1 — no backend auth endpoint)
# The frontend validates these credentials client-side.
# Phase 2 will use real JWT authentication.
# ------------------------------------------
VITE_ADMIN_EMAIL=admin@trading.local
VITE_ADMIN_PASSWORD=admin123

# ------------------------------------------
# Feature Flags
# ------------------------------------------
# Force mock mode even when VITE_API_URL is set
# VITE_USE_MOCKS=false
